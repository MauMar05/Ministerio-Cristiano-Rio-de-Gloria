# Nginx: pegar dentro de server { ... }. La línea limit_req_zone va en el bloque http { ... }
# http { limit_req_zone $binary_remote_addr zone=sitio:10m rate=10r/s; }

# 19. Forzar HTTPS (bloque aparte, puerto 80)
# server { listen 80; server_name tudominio.org; return 301 https://$host$request_uri; }

server_tokens off;
autoindex off;

# 11. Rate limiting
limit_req zone=sitio burst=30 nodelay;
limit_req_status 429;

# Solo métodos de lectura
if ($request_method !~ ^(GET|HEAD|OPTIONS)$) { return 405; }

# 12. Bots y escáneres conocidos
if ($http_user_agent ~* "(sqlmap|nikto|masscan|nmap|zgrab|acunetix|dirbuster|wpscan)") { return 403; }
if ($http_user_agent = "") { return 403; }

# 16. Restringir archivos
location ~ /\. { deny all; }
location ^~ /server-config/ { deny all; }
location ~* \.(?!(html|css|js|jpg|jpeg|png|webp|svg|woff2|ico|txt)$)[a-z0-9]+$ { deny all; }

# 18. Security headers
add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests; frame-ancestors 'none'" always;
add_header X-Frame-Options "DENY" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" always;
add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header Cross-Origin-Resource-Policy "same-origin" always;
